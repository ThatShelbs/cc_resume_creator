.env
__pycache__/
*.pyc
.claude/settings.local.json

# Personal career data: never commit. Folders are kept via .gitkeep.
resume_input/*
!resume_input/.gitkeep
resume_create/*
!resume_create/.gitkeep
resume_archive/*
!resume_archive/.gitkeep

# Resume Taylor (browser app): per-project data and local state. Never commit.
/projects/
/demo_workspace/
/app_settings.json
.taylor_port
.taylor_tmp/
/.venv/
webapp/frontend/node_modules/
# webapp/frontend/dist/ IS committed: it is the prebuilt web app, so users need no Node.js.
webapp/frontend/openapi.json
webapp/frontend/.build-hash

# Personal never-claim list (a starter is tracked as do_not_claim.example.txt)
/do_not_claim.txt
/secrets.json

# Safety net: no resumes or PDFs get committed by accident. Sample files that
# are meant to ship live in examples/ and docs/ and are allowed below.
*.docx
*.pdf
!examples/**/*.docx
!examples/*.docx
!docs/**
!.env.example
