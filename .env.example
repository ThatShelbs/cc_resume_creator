# Copy this file to ".env" (the launcher does it for you the first time).
# ".env" is private and never uploaded to GitHub.
#
# You do NOT need anything here if you signed in with your Claude subscription
# (the launcher walks you through that). Fill in a key only if you prefer to
# pay per use with an Anthropic API key. You can also paste the key in the app
# under Settings instead of here.
#ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning
#CLAUDE_MODEL=sonnet
#CLAUDE_EFFORT=medium
#CLAUDE_TIMEOUT=600
